# Copia este archivo a ".env" (para scripts fuera de Streamlit) y completa los valores.
# Si vas a correr la app con `streamlit run`, usa en su lugar ".streamlit/secrets.toml"
# (ver ".streamlit/secrets.toml.example") — es el mecanismo que Streamlit lee de forma nativa
# y el que usan las otras apps de ISTHO ya desplegadas.

# --- Base de datos (Supabase) ---
SUPABASE_URL=
SUPABASE_KEY=

# --- Aplicación ---
APP_SECRET=
SESSION_SECRET=
TIMEZONE=America/Bogota

# --- Reverse Geocoding ---
# Proveedor por defecto: Nominatim (OpenStreetMap), no requiere API key.
# Si en el futuro se cambia a un proveedor de pago (Google/Mapbox/HERE), la key va aquí.
GEOCODING_PROVIDER=nominatim
GEOCODING_API_KEY=

# --- WhatsApp (Fase 5 — sin proveedor conectado todavía) ---
WHATSAPP_PROVIDER=
WHATSAPP_API_KEY=
WHATSAPP_PHONE_NUMBER_ID=

# --- Email (Fase 5 — sin proveedor conectado todavía) ---
EMAIL_PROVIDER=
EMAIL_API_KEY=
