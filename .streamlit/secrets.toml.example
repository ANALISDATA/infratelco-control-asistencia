# Copia este archivo a ".streamlit/secrets.toml" (mismo nombre de carpeta, sin ".example")
# y completa los valores reales. Ese archivo NUNCA se sube a git ni se comparte
# (está en .gitignore).
#
# Dónde conseguir supabase_url y supabase_key:
#   Panel de Supabase → tu proyecto → Project Settings → API
#   - supabase_url  = "Project URL"
#   - supabase_key  = "service_role" (NO la "anon/public") — la app necesita permisos
#     de escritura completos para registrar asistencia, empleados y auditoría.

supabase_url = "https://xxxxxxxx.supabase.co"
supabase_key = "TU_SERVICE_ROLE_KEY_AQUI"

app_secret = "genera-un-texto-largo-y-aleatorio-aqui"
session_secret = "genera-otro-texto-largo-y-aleatorio-aqui"

timezone = "America/Bogota"

geocoding_provider = "nominatim"
geocoding_api_key = ""

whatsapp_provider = ""
whatsapp_api_key = ""
whatsapp_phone_number_id = ""

email_provider = ""
email_api_key = ""
